# Chromium and Lighthouse for site-audit rendering and Lighthouse checks
# (scripts/celld/runtime/browser-gateway.mjs). Separate from the app image so the
# runtime, init and crawl gateway do not carry a browser.
FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation fonts-noto-color-emoji fonts-noto-cjk ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /opt/browser
COPY deploy/standalone/browser/package.json deploy/standalone/browser/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY scripts/celld/runtime/browser-gateway.mjs scripts/celld/runtime/crawl-gateway.mjs ./
USER node
ENV CHROMIUM_PATH=/usr/bin/chromium
CMD ["node", "/opt/browser/browser-gateway.mjs"]
